# ===========================================
# NestJS AI SaaS Starter - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your actual values
# File location: apps/dev-brand-api/.env

# ===========================================
# CRITICAL: Required API Keys
# ===========================================

# HuggingFace API Key (REQUIRED for default embedding provider)
# Get your key from: https://huggingface.co/settings/tokens
# Free tier available - just create an account
HUGGINGFACE_API_KEY=

# OpenAI API Key (Alternative embedding provider + LLM)
# Get your key from: https://platform.openai.com/api-keys
# Paid service - requires credit card
OPENAI_API_KEY=

# OpenRouter API Key (For LLM operations with multiple providers)
# Get your key from: https://openrouter.ai/keys
# IMPORTANT: Configure privacy settings at https://openrouter.ai/settings/privacy
# Pay-as-you-go pricing
OPENROUTER_API_KEY=

# ===========================================
# Database Configuration (Docker Defaults)
# ===========================================

# ChromaDB Configuration
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_SSL=false
CHROMADB_TENANT=default_tenant
CHROMADB_DATABASE=default_database
CHROMADB_TIMEOUT=30000
CHROMADB_MAX_RETRIES=3
CHROMADB_RETRY_DELAY=1000

# Neo4j Configuration
# Default password is set in docker-compose.dev.yml
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=development_password
NEO4J_DATABASE=neo4j
NEO4J_MAX_POOL_SIZE=100
NEO4J_CONNECTION_TIMEOUT=60000
NEO4J_ENCRYPTED=false

# Redis Configuration
REDIS_URL=redis://localhost:6379

# ===========================================
# Embedding Provider Configuration
# ===========================================

# Choose embedding provider: 'openai' | 'huggingface' | 'cohere'
# Default: huggingface (free)
CHROMADB_EMBEDDING_PROVIDER=huggingface

# HuggingFace Embedding Settings
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_DIMENSIONS=384
HUGGINGFACE_BATCH_SIZE=50

# OpenAI Embedding Settings (uncomment if using openai provider)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSIONS=1536
# OPENAI_BATCH_SIZE=100

# ===========================================
# LLM Provider Configuration
# ===========================================

# LangChain/LangGraph LLM Provider
# Options: 'openai' | 'anthropic' | 'google' | 'openrouter'
LLM_PROVIDER=openai

# OpenRouter Configuration
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ===========================================
# Application Configuration
# ===========================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_PORT=8080
WEBSOCKET_NAMESPACE=/streaming

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# Text Processing Configuration
TEXT_CHUNK_SIZE=1000
TEXT_CHUNK_OVERLAP=200
TEXT_MAX_LENGTH=8000

# Collection Configuration
DEFAULT_COLLECTION_NAME=documents
DEFAULT_BATCH_SIZE=100

# ===========================================
# Performance & Monitoring
# ===========================================

# ChromaDB Performance
CHROMADB_PERFORMANCE_CACHING=true
CHROMADB_PERFORMANCE_MONITORING=true
CHROMADB_PERFORMANCE_CIRCUIT_BREAKER=true
CHROMADB_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CHROMADB_CIRCUIT_BREAKER_RESET_TIMEOUT=60000

# Logging
LOG_CONNECTION_DETAILS=true
LOG_EMBEDDING_OPERATIONS=false

# ===========================================
# Feature Flags
# ===========================================

# Multi-Tenancy (disabled by default)
CHROMADB_MULTI_TENANT_ENABLED=false

# Time Travel (enabled in development)
ENABLE_TIME_TRAVEL_PROD=false
