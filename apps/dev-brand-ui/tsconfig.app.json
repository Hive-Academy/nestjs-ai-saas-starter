{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": [],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "target": "es2022",
    "useDefineForClassFields": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["jest.config.ts", "src/test-setup.ts", "src/**/*.test.ts", "src/**/*.spec.ts"]
}
