{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/libs/nestjs-neo4j",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "emitDeclarationOnly": false,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts"],
  "references": [],
  "exclude": [
