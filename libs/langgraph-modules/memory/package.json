{
  "name": "@hive-academy/langgraph-memory",
  "version": "0.0.1",
  "description": "Standalone NestJS Memory Module With Adapters for VectorStore service and GraphMemory service",
  "main": "./index.cjs.js",
  "module": "./index.esm.js",
  "types": "./index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./index.d.ts",
      "import": "./index.esm.js",
      "default": "./index.cjs.js"
    }
  },
  "files": [
    "index.*.js",
    "index.*.js.map",
    "index.d.ts",
    "index.d.ts.map",
    "src/**/*.d.ts",
    "src/**/*.d.ts.map",
    "*.md",
    "!*.tsbuildinfo"
  ],
  "keywords": [
    "nestjs",
    "memory",
    "vector-database",
    "graph-database",
    "semantic-search",
    "ai"
  ],
  "author": "Hive Academy",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hive-academy/nestjs-ai-saas-starter.git",
    "directory": "libs/langgraph-modules/memory"
  },
  "homepage": "https://github.com/hive-academy/nestjs-ai-saas-starter#readme",
  "bugs": {
    "url": "https://github.com/hive-academy/nestjs-ai-saas-starter/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "@nestjs/common": "*",
    "@nestjs/core": "*",
    "@nestjs/config": "*",
    "@langchain/core": "*",
    "zod": "*",
    "rxjs": "*",
    "reflect-metadata": "*"
  }
}
