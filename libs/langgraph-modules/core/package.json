{
  "name": "@hive-academy/langgraph-core",
  "version": "0.0.1",
  "description": "Core library for LangGraph modules providing essential interfaces and utilities",
  "author": "Hive Academy Team",
  "license": "MIT",
  "keywords": [
    "nestjs",
    "langgraph",
    "ai",
    "hiveacademy",
    "langchain",
    "modules",
    "core"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hive-academy/nestjs-ai-saas-starter.git",
    "directory": "libs/langgraph-modules/core"
  },
  "homepage": "https://github.com/hive-academy/nestjs-ai-saas-starter#readme",
  "bugs": {
    "url": "https://github.com/hive-academy/nestjs-ai-saas-starter/issues"
  },
  "private": false,
  "main": "./index.cjs.js",
  "module": "./index.esm.js",
  "types": "./index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./index.d.ts",
      "import": "./index.esm.js",
      "require": "./index.cjs.js",
      "default": "./index.cjs.js"
    }
  },
  "files": [
    "index.*.js",
    "index.*.js.map",
    "index.d.ts",
    "index.d.ts.map",
    "src/**/*.d.ts",
    "src/**/*.d.ts.map",
    "*.md",
    "!*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@nestjs/common": "*",
    "reflect-metadata": "*",
    "@langchain/langgraph": "*",
    "@langchain/core": "*"
  },
  "devDependencies": {
    "rollup": "*",
    "@rollup/plugin-typescript": "*",
    "rollup-plugin-dts": "*",
    "@nestjs/testing": "*"
  }
}
