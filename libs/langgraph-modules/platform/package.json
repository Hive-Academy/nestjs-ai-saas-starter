{
  "name": "@hive-academy/langgraph-platform",
  "version": "0.0.1",
  "description": "Platform integrations for LangGraph modules with NestJS ChromaDB vector database support",
  "author": "Hive Academy Team",
  "license": "MIT",
  "keywords": [
    "nestjs",
    "langgraph",
    "ai",
    "hiveacademy",
    "langchain",
    "modules",
    "platform",
    "chromadb"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hive-academy/nestjs-ai-saas-starter.git",
    "directory": "libs/langgraph-modules/platform"
  },
  "homepage": "https://github.com/hive-academy/nestjs-ai-saas-starter#readme",
  "bugs": {
    "url": "https://github.com/hive-academy/nestjs-ai-saas-starter/issues"
  },
  "private": false,
  "main": "./index.cjs.js",
  "module": "./index.esm.js",
  "types": "./src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.d.ts",
      "import": "./index.esm.js",
      "require": "./index.cjs.js",
      "default": "./index.esm.js"
    }
  },
  "files": [
    "index.*.js",
    "index.*.js.map",
    "index.d.ts",
    "index.d.ts.map",
    "src/**/*.d.ts",
    "src/**/*.d.ts.map",
    "*.md",
    "!*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "tslib": "*",
    "@nestjs/common": "*",
    "axios": "*"
  }
}
