{
  "name": "@hive-academy/langgraph-hitl",
  "version": "0.0.1",
  "description": "Enterprise-grade Human-in-the-Loop system with ML confidence scoring, approval chains, and memory integration for LangGraph workflows",
  "author": "Hive Academy",
  "keywords": [
    "nestjs",
    "neo4j",
    "graph-database",
    "cypher",
    "relationships",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hive-academy/nestjs-ai-saas-starter.git",
    "directory": "libs/langgraph-modules/workflow-engine"
  },
  "homepage": "https://github.com/hive-academy/nestjs-ai-saas-starter#readme",
  "bugs": {
    "url": "https://github.com/hive-academy/nestjs-ai-saas-starter/issues"
  },
  "license": "MIT",
  "private": false,
  "main": "./index.cjs.js",
  "module": "./index.esm.js",
  "types": "./index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./index.d.ts",
      "import": "./index.esm.js",
      "require": "./index.cjs.js",
      "default": "./index.cjs.js"
    }
  },
  "files": [
    "index.*.js",
    "index.*.js.map",
    "index.d.ts",
    "index.d.ts.map",
    "src/**/*.d.ts",
    "src/**/*.d.ts.map",
    "*.md",
    "!*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@nestjs/common": "*",
    "@hive-academy/langgraph-core": "*",
    "reflect-metadata": "*",
    "@nestjs/event-emitter": "*",
    "@nestjs/config": "*",
    "@langchain/core": "*",
    "@langchain/langgraph": "*",
    "@hive-academy/langgraph-memory": "*",
    "@hive-academy/langgraph-workflow-engine": "*"
  },
  "devDependencies": {
    "rollup": "*",
    "@rollup/plugin-typescript": "*",
    "rollup-plugin-dts": "*",
    "@nestjs/testing": "*"
  }
}
