# ChromaDB Configuration
# Connection settings for ChromaDB instance - REQUIRED in production
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_SSL=false
CHROMADB_TENANT=default_tenant
CHROMADB_DATABASE=default_database

# HTTP Configuration
CHROMADB_TIMEOUT=30000
CHROMADB_MAX_RETRIES=3
CHROMADB_RETRY_DELAY=1000
CHROMADB_RETRY_BACKOFF_FACTOR=2

# Embedding Provider Configuration
# Choose one: openai, huggingface, cohere, custom
EMBEDDING_PROVIDER=openai

# OpenAI Embedding Configuration (if using openai provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_ENDPOINT=https://api.openai.com/v1/embeddings
OPENAI_ORGANIZATION=your_organization_id
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_BATCH_SIZE=100
OPENAI_MAX_INPUT_TOKENS=8191

# HuggingFace Embedding Configuration (if using huggingface provider)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_API_ENDPOINT=https://api-inference.huggingface.co/pipeline/feature-extraction
HUGGINGFACE_DIMENSIONS=384
HUGGINGFACE_BATCH_SIZE=50

# Cohere Embedding Configuration (if using cohere provider)
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=embed-english-v3.0
COHERE_API_ENDPOINT=https://api.cohere.ai/v1/embed
COHERE_DIMENSIONS=1024
COHERE_BATCH_SIZE=96

# Text Processing Configuration
TEXT_CHUNK_SIZE=1000
TEXT_CHUNK_OVERLAP=200
TEXT_MAX_LENGTH=8000

# Collection Configuration
DEFAULT_COLLECTION_NAME=documents
DEFAULT_BATCH_SIZE=100

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000

# Logging Configuration
LOG_CONNECTION_DETAILS=true
LOG_EMBEDDING_OPERATIONS=true


# === NEW: Decorator Configuration ===
CHROMADB_DECORATORS_ENABLED=true
CHROMADB_DECORATORS_AUTO_GENERATE=true
CHROMADB_DECORATORS_TYPE_VALIDATION=true
CHROMADB_DECORATORS_AUTO_METADATA=true

# === NEW: Decorator Caching ===
CHROMADB_DECORATORS_CACHING_ENABLED=true
CHROMADB_DECORATORS_CACHE_TTL=300000
CHROMADB_DECORATORS_CACHE_STRATEGY=memory
CHROMADB_DECORATORS_CACHE_PREFIX=chroma_

# === NEW: Decorator Profiling ===
CHROMADB_DECORATORS_PROFILING_ENABLED=true
CHROMADB_DECORATORS_SLOW_QUERY_THRESHOLD=100
CHROMADB_DECORATORS_SAMPLING_RATE=1.0
CHROMADB_DECORATORS_INCLUDE_STACK_TRACE=false

# === NEW: Decorator Retry ===
CHROMADB_DECORATORS_RETRY_ENABLED=true
CHROMADB_DECORATORS_MAX_ATTEMPTS=3
CHROMADB_DECORATORS_BASE_DELAY=1000
CHROMADB_DECORATORS_RETRY_STRATEGY=exponential

# === NEW: Performance Monitoring ===
CHROMADB_PERFORMANCE_CACHING=true
CHROMADB_PERFORMANCE_MONITORING=true
CHROMADB_PERFORMANCE_CIRCUIT_BREAKER=true
CHROMADB_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CHROMADB_CIRCUIT_BREAKER_RESET_TIMEOUT=60000
CHROMADB_CIRCUIT_BREAKER_MONITORING_PERIOD=10000

# === NEW: Performance Metrics ===
CHROMADB_METRICS_EMBEDDING_TIME=true
CHROMADB_METRICS_SEARCH_TIME=true
CHROMADB_METRICS_BATCH_TIME=true

# === NEW: Multi-Tenant Configuration (Optional) ===
# Uncomment to enable multi-tenancy
# CHROMADB_MULTI_TENANT_ENABLED=true
# CHROMADB_MULTI_TENANT_STRATEGY=prefix
# CHROMADB_MULTI_TENANT_SEPARATOR=_
# CHROMADB_MULTI_TENANT_SECURITY=strict

# === NEW: Cross-Tenant Operations (Optional) ===
# Uncomment to enable cross-tenant operations (admin use)
# CHROMADB_CROSS_TENANT_ENABLED=false
# CHROMADB_CROSS_TENANT_REQUIRE_AUTH=true
# CHROMADB_CROSS_TENANT_AUDIT_LOG=true
# CHROMADB_CROSS_TENANT_RATE_LIMIT=100
# CHROMADB_CROSS_TENANT_RATE_WINDOW=3600

# === Default Values for Reference ===
DEFAULT_COLLECTION_NAME=documents
DEFAULT_BATCH_SIZE=100
TEXT_CHUNK_SIZE=1000
TEXT_CHUNK_OVERLAP=200
TEXT_MAX_LENGTH=8000

# === Health Check & Monitoring ===
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
LOG_CONNECTION_DETAILS=true
LOG_EMBEDDING_OPERATIONS=false
