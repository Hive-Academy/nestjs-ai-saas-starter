{
  "name": "@hive-academy/nestjs-chromadb",
  "version": "0.0.1",
  "description": "NestJS integration for ChromaDB vector database with comprehensive TypeScript support",
  "author": "Hive Academy Team",
  "license": "MIT",
  "keywords": [
    "nestjs",
    "chromadb",
    "vector-database",
    "embeddings",
    "ai",
    "machine-learning",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hive-academy/nestjs-ai-saas-starter.git",
    "directory": "libs/nestjs-chromadb"
  },
  "homepage": "https://github.com/hive-academy/nestjs-ai-saas-starter#readme",
  "bugs": {
    "url": "https://github.com/hive-academy/nestjs-ai-saas-starter/issues"
  },
  "main": "./index.cjs.js",
  "module": "./index.esm.js",
  "types": "./index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./index.d.ts",
      "import": "./index.esm.js",
      "require": "./index.cjs.js",
      "default": "./index.cjs.js"
    }
  },
  "files": [
    "index.*.js",
    "index.*.js.map",
    "index.d.ts",
    "index.d.ts.map",
    "src/**/*.d.ts",
    "src/**/*.d.ts.map",
    "*.md",
    "!*.tsbuildinfo"
  ],
  "peerDependencies": {
    "@langchain/anthropic": "*",
    "@langchain/core": "*",
    "@langchain/google-genai": "*",
    "@langchain/langgraph": "*",
    "@langchain/langgraph-checkpoint": "*",
    "@langchain/langgraph-checkpoint-sqlite": "*",
    "@langchain/openai": "*",
    "@langchain/textsplitters": "*",
    "@nestjs/common": "*",
    "@nestjs/config": "*",
    "@nestjs/core": "*",
    "@nestjs/event-emitter": "*",
    "@nestjs/platform-express": "*",
    "@nestjs/swagger": "*",
    "@nestjs/terminus": "*",
    "chromadb": "*",
    "cohere-ai": "*",
    "langchain": "*",
    "neo4j-driver": "*",
    "openai": "*",
    "reflect-metadata": "*",
    "rxjs": "*"
  },
  "dependencies": {
    "tslib": "*"
  },
  "devDependencies": {
    "@nestjs/testing": "*"
  }
}
